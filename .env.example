# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Only the anon (public) key belongs here. The service_role key must never reach the client.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Web push public key (the private key is an Edge Function secret, never here).
# Generate a pair with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
